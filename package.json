{
  "name": "aegis-grid",
  "version": "4.0.0",
  "description": "Observatorio abierto de energia de Ecuador y clima de Pallatanga con tendencias, fuentes y escenarios",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chart.js": "^4.5.1",
    "fastify": "^5.12.5",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "5.4.624",
    "proj4": "2.22.0",
    "web-push": "3.6.7"
  },
  "scripts": {
    "start": "node backend.js",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "example:source": "node scripts/example-source-adapter.mjs --run",
    "benchmark:hazards": "node scripts/benchmark-hazards.mjs",
    "benchmark:compare": "node scripts/benchmark-hazards.mjs --baseline=replay/benchmarks/rain-watch-controls.baseline.v1.json",
    "storage": "node scripts/storage.js",
    "reports": "node scripts/reports.js",
    "correlation": "node scripts/correlation.js",
    "schedules": "node scripts/schedules.js",
    "push": "node scripts/push.js",
    "feeds": "node scripts/feeds.js",
    "openapi": "node scripts/export-openapi.mjs"
  }
