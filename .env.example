PORT=3010
AMBIENT_MAC=
# Use a mounted persistent directory in production.
DATA_DIR=.data
# AEGIS 5 foundations: only the exact value true enables a flag.
PUBLIC_API_V1=false
BLACKOUT_MAP=false
BLACKOUT_DEMO=false
CITIZEN_REPORTS=false
# CLI only: explicitly authorize correlation mutations; no background ingestion.
EVENT_CORRELATION=false
# Required for live citizen reports: exact external HTTPS origin, no trailing slash.
REPORTS_ORIGIN=
# Manual schedule CLI + explicit GET; requires PUBLIC_API_V1/SQLITE_STORAGE on server.
OFFICIAL_SCHEDULES=false
PUSH_ALERTS=false
OSINT_NEWS=false
OSINT_X=false
TIME_MACHINE=false
EXPLORER_3D=false
# Optional SQLite v5, separate from observations.json. Requires Node >=22.16.
SQLITE_STORAGE=false
DB_DIR=.data/v5
DB_MAX_BYTES=67108864
# CLI only: separate synthetic database; never enable for live storage.
SQLITE_DEMO=false

# Sector Watch: required only when PUSH_ALERTS=true. Keep private keys outside git.
WATCH_ORIGIN=
PUSH_STORAGE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Independent delivery gate: enrollment never enables the sender.
PUSH_DELIVERY=false
# Integration safety: true is rejected; there is no real-delivery override.
# Multihazard features are independent of v5 and OFF by default.
HAZARDS_ENABLED=false
ALERTS_ADMIN_ENABLED=false
ALERTS_ADMIN_CREDENTIALS_JSON=
ZONE_SUBSCRIPTIONS_ENABLED=false
ALERTS_PUBLISH_ENABLED=false
